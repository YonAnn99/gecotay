# ---------------------------------------------------------------------------
# Supabase — captura de leads (formularios de /contacto y /cotizar)
# ---------------------------------------------------------------------------

# URL pública del proyecto. Segura de exponer al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://ffhyxkawjcegvbgbfqke.supabase.co"

# SECRETO. Salta RLS por completo: es la única vía de escritura a las tablas
# `contactos` y `cotizaciones`, que tienen RLS activa y cero políticas.
# NO lleva prefijo NEXT_PUBLIC_ a propósito — si lo llevara, Next la
# incrustaría en el bundle del navegador y quedaría expuesta a cualquiera.
# Obtenerla en: Dashboard → Project Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Clave publicable. Es segura de exponer: solo puede hacer lo que las políticas
# RLS permitan, y las tablas internas (perfiles, invitaciones, leads) no le
# conceden nada. La usa el cliente de sesión para validar el JWT del usuario.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_Q7qWHRg5cmKLFchPN4zk3w_k5P9Iizq"

# SECRETO. Sal para hashear la IP de quien envía un formulario. Nunca
# guardamos la IP en claro; solo necesitamos correlacionar envíos abusivos
# entre sí para el rate limiting. Sin esta sal el hash sería reversible por
# fuerza bruta (el espacio IPv4 es pequeño), así que si falta simplemente
# no se guarda huella alguna. Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_IP_SALT=""

# URL canónica del sitio (usada por metadataBase, sitemap y JSON-LD).
# Si se omite, app/data/empresa.ts cae a https://www.gecotay.com
# NEXT_PUBLIC_SITE_URL="https://www.gecotay.com"

# ---------------------------------------------------------------------------
# Correo transaccional (invitaciones de colaboradores)
# ---------------------------------------------------------------------------
# OJO: el SMTP que se configura en Supabase → Auth → Settings solo cubre los
# correos que Supabase Auth manda por su cuenta (confirmación, magic link,
# recuperación). El correo con el código de invitación es nuestro, así que
# necesita su propio emisor. Se usa la API HTTP de Resend.
#
# Sin estas dos variables NO se rompe nada: la invitación se crea igual y el
# panel muestra el código para que el admin lo haga llegar por su cuenta.
RESEND_API_KEY=""
# Debe ser un remitente de un dominio verificado en Resend.
CORREO_REMITENTE="Grupo Gecotay <no-responder@gecotay.com>"

# URL del módulo de ventas, para el enlace del correo de invitación.
NEXT_PUBLIC_URL_VENTAS="https://ventas.gecotay.com"
